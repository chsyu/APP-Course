{
  "expo": {
    "name": "my-app",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.themeanimations.myapp",
      "supportsTablet": true
    },
    "android": {
      "package": "com.themeanimations.myapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 320,
            "resizeMode": "cover",
            "backgroundColor": "#29303a",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "backgroundColor": "#29303a"
            }
          },
          "android": {
            "image": "./assets/images/icon.png",
            "imageWidth": 320,
            "resizeMode": "cover",
            "backgroundColor": "#29303a",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "backgroundColor": "#29303a"
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允許 $(PRODUCT_NAME) 使用你的位置，以便在日記與地圖上標記建立地點。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允許 $(PRODUCT_NAME) 存取你的相簿，以便在日記中選取與附加照片。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
